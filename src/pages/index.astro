---
import { getCollection } from 'astro:content';
import '../styles/global.css';

// Obtenemos las colecciones para poder mostrar contadores si lo deseas
const todasLasTareas = await getCollection('tareas');
const todosLosGuiados = await getCollection('guiados');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal | Integración de Tecnologías</title>
  </head>
  <body class="bg-slate-950 text-slate-200 min-h-screen font-sans selection:bg-emerald-500/30">
    
    <div class="max-w-5xl mx-auto p-6 md:p-12">
      <!-- Encabezado / Perfil Estudiantil -->
      <header class="bg-slate-900 border border-slate-800 rounded-2xl p-8 mb-10 shadow-lg shadow-black/20 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mb-2">
            Portafolio: Integración de Tecnologías Computacionales
          </h1>
          <div class="flex flex-col gap-1 text-slate-400">
            <p class="text-lg">
              <span class="text-slate-300 font-medium">Santiago López Cervantes</span>
            </p>
            <p class="text-sm">Ingeniería en Tecnologías Computacionales</p>
          </div>
        </div>
        <div class="flex gap-4">
          <a href="https://github.com/vrdtska" target="_blank" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-sm font-semibold transition-all border border-slate-700 hover:border-slate-600 flex items-center gap-2">
            GitHub
          </a>
          <a href="https://linkedin.com/in/santiago-lopez-70b610267" target="_blank" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-sm font-semibold transition-all shadow-md shadow-blue-900/20">
            LinkedIn
          </a>
        </div>
      </header>

      <!-- Navegación Principal: Categorías -->
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <!-- Tarjeta de Ejercicios Guiados -->
        <a href="/guiados" class="group block bg-slate-900 border border-slate-800 hover:border-emerald-500/50 rounded-2xl p-8 transition-all hover:shadow-lg hover:shadow-emerald-900/20">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold text-slate-100 group-hover:text-emerald-400 transition-colors">Ejercicios Guiados</h2>
            <span class="bg-slate-800 text-emerald-400 px-3 py-1 rounded-full text-xs font-bold border border-slate-700">{todosLosGuiados.length} entradas</span>
          </div>
          <p class="text-slate-400">Prácticas realizadas en clase y ejercicios paso a paso del semestre.</p>
        </a>

        <!-- Tarjeta de Tareas -->
        <a href="/tareas" class="group block bg-slate-900 border border-slate-800 hover:border-blue-500/50 rounded-2xl p-8 transition-all hover:shadow-lg hover:shadow-blue-900/20">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold text-slate-100 group-hover:text-blue-400 transition-colors">Tareas</h2>
            <span class="bg-slate-800 text-blue-400 px-3 py-1 rounded-full text-xs font-bold border border-slate-700">{todasLasTareas.length} entradas</span>
          </div>
          <p class="text-slate-400">Asignaciones, investigaciones y entregables desarrollados fuera del aula.</p>
        </a>
      </div>

      <!-- Sección de Proyecto Final -->
      <section class="bg-gradient-to-br from-indigo-900/40 to-slate-900 border border-indigo-500/30 rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-indigo-300 mb-3">Proyecto Final</h2>
        <p class="text-indigo-200/70 mb-6">Detalles, documentación y despliegue del proyecto integrador del curso.</p>
        <button class="px-6 py-2.5 bg-indigo-600/20 text-indigo-300 border border-indigo-500/50 rounded-xl text-sm font-semibold cursor-not-allowed opacity-80">
          Próximamente
        </button>
      </section>
    </div>
  </body>
</html>