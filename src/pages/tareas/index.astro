---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

// Obtener todas las entradas y ordenarlas por fecha (de más nueva a más vieja)
// NOTA: Cambia 'guiados' por 'tareas' cuando uses este código en la otra página
const todasLasEntradas = await getCollection('tareas');
const entradasOrdenadas = todasLasEntradas.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

// Filtrar por parcial
const parcial1 = entradasOrdenadas.filter(t => t.data.parcial === 'parcial-1');
const parcial2 = entradasOrdenadas.filter(t => t.data.parcial === 'parcial-2');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tareas | Portal Académico</title>
  </head>
  <body class="bg-slate-950 text-slate-200 min-h-screen font-sans antialiased selection:bg-blue-500/30">
    
    <!-- Elemento decorativo de fondo -->
    <div class="absolute top-0 left-0 w-full h-96 bg-gradient-to-b from-blue-900/10 to-transparent -z-10 pointer-events-none"></div>

    <div class="max-w-6xl mx-auto p-6 md:p-12 lg:px-8">
      
      <!-- Navegación superior mejorada -->
      <nav class="mb-12">
        <a href="/~iac-612956/" class="group inline-flex items-center gap-2 px-4 py-2 bg-slate-900/50 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 rounded-lg text-sm font-medium text-slate-400 hover:text-slate-100 transition-all backdrop-blur-sm shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Volver al Portal
        </a>
      </nav>

      <!-- Encabezado con gradiente -->
      <header class="mb-16 max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400 mb-4 tracking-tight">
          Tareas
        </h1>
        <p class="text-slate-400 text-lg leading-relaxed">
          Explora el registro estructurado de tareas desarrolladas durante el curso.
        </p>
      </header>

      <!-- SECCIÓN PARCIAL 1 -->
      <section class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <h2 class="text-2xl font-bold text-white tracking-wide">Parcial 1</h2>
          <div class="h-[1px] flex-grow bg-gradient-to-r from-slate-800 to-transparent"></div>
        </div>
        
        {parcial1.length === 0 ? (
          <div class="p-8 border border-dashed border-slate-800 rounded-2xl bg-slate-900/20 text-center">
            <p class="text-slate-500 italic">Aún no hay entregables registrados en este parcial.</p>
          </div>
        ) : (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-6">
            {parcial1.map(entrada => (
              <a href={`/~iac-612956/tareas/${entrada.id}/`} class="group relative flex flex-col justify-between p-6 bg-slate-900/80 backdrop-blur-sm border border-slate-800 rounded-2xl hover:bg-slate-800/80 hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-900/20 overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/5 rounded-bl-[100px] -z-10 transition-colors group-hover:bg-emerald-500/10"></div>
                <div>
                  <h3 class="text-xl font-semibold text-slate-200 group-hover:text-emerald-400 mb-3 transition-colors">{entrada.data.title}</h3>
                  <p class="text-sm text-slate-400 leading-relaxed mb-6 line-clamp-3">{entrada.data.description}</p>
                </div>
                <div class="flex items-center text-xs font-medium text-slate-500 group-hover:text-slate-400 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {new Date(entrada.data.pubDate).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
                </div>
              </a>
            ))}
          </div>
        )}
      </section>

      <!-- SECCIÓN PARCIAL 2 -->
      <section class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <h2 class="text-2xl font-bold text-white tracking-wide">Parcial 2</h2>
          <div class="h-[1px] flex-grow bg-gradient-to-r from-slate-800 to-transparent"></div>
        </div>
        
        {parcial2.length === 0 ? (
          <div class="p-8 border border-dashed border-slate-800 rounded-2xl bg-slate-900/20 text-center">
            <p class="text-slate-500 italic">Aún no hay entregables registrados en este parcial.</p>
          </div>
        ) : (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-6">
            {parcial2.map(entrada => (
              <a href={`/~iac-612956/tareas/${entrada.id}/`} class="group relative flex flex-col justify-between p-6 bg-slate-900/80 backdrop-blur-sm border border-slate-800 rounded-2xl hover:bg-slate-800/80 hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-900/20 overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/5 rounded-bl-[100px] -z-10 transition-colors group-hover:bg-emerald-500/10"></div>
                <div>
                  <h3 class="text-xl font-semibold text-slate-200 group-hover:text-emerald-400 mb-3 transition-colors">{entrada.data.title}</h3>
                  <p class="text-sm text-slate-400 leading-relaxed mb-6 line-clamp-3">{entrada.data.description}</p>
                </div>
                <div class="flex items-center text-xs font-medium text-slate-500 group-hover:text-slate-400 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {new Date(entrada.data.pubDate).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
                </div>
              </a>
            ))}
          </div>
        )}
      </section>

    </div>
  </body>
</html>